# Primary Gemini key.
GEMINI_API_KEY=""

# Optional extra keys, comma separated. Free-tier quota is capped per key per
# model, so each additional key adds a whole new daily budget. The service tries
# the best model on every key before falling back to a weaker model.
GEMINI_API_KEYS=""

# Optional overrides.
# GEMINI_MODEL="gemini-2.5-flash"
# GEMINI_MODELS="gemini-2.5-flash,gemini-2.0-flash,gemini-2.0-flash-lite"

GROQ_API_KEY=""
